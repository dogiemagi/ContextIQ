# Leave everything blank to run fully offline (deterministic extractive model, no API key).
# Provider is auto-detected from whichever key is set, or force it with LLM_PROVIDER.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic|openai|offline
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o-mini

# hashing = zero-dependency lexical embeddings, st = sentence-transformers (pip install sentence-transformers)
EMBEDDINGS=hashing

# Real prices (USD per million tokens) so the cost metric is meaningful
PRICE_IN_PER_MTOK=0
PRICE_OUT_PER_MTOK=0

# Production database (Neon / Supabase / any Postgres). Leave blank to use a local SQLite file.
# Use the connection string from your provider's dashboard - keep it secret, never commit it.
DATABASE_URL=

# Protect the API: clients must send X-API-Key
TRUSTRAG_API_KEY=
RATE_LIMIT_PER_MIN=60
